# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repo (ya está en .gitignore).

# URL de la escena de Spline publicada (export "Code / Viewer" → .splinecode)
# La obtienes en Spline: Export → React / Viewer. Ejemplo:
# https://prod.spline.design/XXXXXXXX/scene.splinecode
# Sala del nivel 7 "El Reino del Éter" (escena con su propio código: estados, portal, estrellas)
VITE_SPLINE_AETHER_URL=

# Universo principal (portal + 7 planetas)
VITE_SPLINE_SCENE_URL=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gurú (agente de voz de ElevenLabs): Agent ID público del agente
VITE_ELEVENLABS_AGENT_ID=
# Voces de Gurú (voice IDs de ElevenLabs; no son secretos). Vacías = la voz propia del agente.
# Requieren el interruptor "Voz" encendido en el agente: Configuración → Seguridad → Sobrescrituras.
# Elegidas por Reyna el 2026-11-12 (nativas de inglés, para un español neutro):
#   femenina = Katie  m4hBEimiy2ffkQ0hHMVD
#   masculina = Felix Sq93GQT4X1lKDXsQcixO  (también es la voz principal del agente)
VITE_GURU_VOICE_FEMALE=
VITE_GURU_VOICE_MALE=

# Clave de API de ElevenLabs: SOLO para grabar la voz guía desde la Mac.
# Sin prefijo VITE_ a propósito, para que nunca viaje dentro de la app.
ELEVENLABS_API_KEY=
