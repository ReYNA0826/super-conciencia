# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repo (ya está en .gitignore).

# URL de la escena de Spline publicada (export "Code / Viewer" → .splinecode)
# La obtienes en Spline: Export → React / Viewer. Ejemplo:
# https://prod.spline.design/XXXXXXXX/scene.splinecode
# Sala del nivel 7 "El Reino del Éter" (escena con su propio código: estados, portal, estrellas)
VITE_SPLINE_AETHER_URL=

# Universo principal (portal + 7 planetas)
VITE_SPLINE_SCENE_URL=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
