# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repo (ya está en .gitignore).

# URL de la escena de Spline publicada (export "Code / Viewer" → .splinecode)
# La obtienes en Spline: Export → React / Viewer. Ejemplo:
# https://prod.spline.design/XXXXXXXX/scene.splinecode
VITE_SPLINE_SCENE_URL=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
